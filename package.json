{
  "name": "rail-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "yarn getModels && vite",
    "build": "tsc -b && vite build",
    "lint": "node scripts/lint-changed.mjs",
    "lint:full": "eslint .",
    "lint:changed": "node scripts/lint-changed.mjs",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "check:layers": "node scripts/check-layer-imports.mjs",
    "check:layers:full": "node scripts/check-layer-imports-full.mjs --strict",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:architecture": "npm run check:layers && npm run check:manifests",
    "check:architecture:full": "npm run check:layers:full && npm run check:manifests",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude src/test/integration/**",
    "test:integration": "vitest run src/test/integration",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "schema": "node scripts/generate-schema-types.mjs",
    "getModels": "node scripts/getModels.mjs",
    "startapp": "node scripts/startapp.mjs",
    "register": "node scripts/register.mjs",
    "unregister": "node scripts/unregister.mjs"
