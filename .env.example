# GraphQL Endpoints
VITE_BACKEND_URL=http://localhost:8000
VITE_AUTH_ENDPOINT=/graphql/auth/
VITE_API_ENDPOINT=/graphql/gql/
VITE_API_EXPORTING=/api/v1/export/

# CSRF bootstrap (recommended for cookie-based auth)
# Backend should expose an endpoint that returns a CSRF token in a response header
# or JSON body. Example: header `X-CSRFToken` or JSON `{ "csrfToken": "..." }`.
VITE_CSRF_ENDPOINT=/csrf/
VITE_CSRF_RESPONSE_HEADER=X-CSRFToken
VITE_CSRF_HEADER_NAME=X-CSRFToken
VITE_CSRF_COOKIE_NAME=csrftoken
# Keep false to avoid writing CSRF cookies from the browser (safer default).
VITE_CSRF_WRITE_COOKIE=false


VITE_TEST_USERNAME=mkhaled
VITE_TEST_PASSWORD=rail-2025
VITE_TEST_GRAPHQL_ENDPOINT=http://localhost:8000/graphql-test/

# Frontend container publish port (used by deploy/deploy.ps1)
RAIL_REACT_PORT=8080
