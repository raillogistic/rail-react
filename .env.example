# Backend base URL (protocol + host + port, no trailing slash)
VITE_BACKEND_URL=http://localhost:8000

# API endpoints (paths relative to backend, or absolute URLs)
VITE_API_ENDPOINT=/graphql/gql/
VITE_AUTH_ENDPOINT=/graphql/auth/
VITE_API_EXPORTING=/api/v1/export/
# VITE_CSRF_ENDPOINT=/csrf/

# Environment
VITE_ENV=development

# Session idle timeout (minutes)
VITE_AUTO_LOGOUT_ENABLED=true
VITE_IDLE_TIMEOUT_MIN=15
VITE_IDLE_WARNING_MIN=2
